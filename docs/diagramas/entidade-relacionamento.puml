MedicoEspecialidade "0..*" -- "1" Especialidade : FK especialidadeId
ProfissionalUnidade "0..*" -- "1" Profissional : FK profissionalId
ProfissionalUnidade "0..*" -- "1" Unidade : FK unidadeId
UnidadeEspecialidade "0..*" -- "1" Unidade : FK unidadeId
UnidadeEspecialidade "0..*" -- "1" Especialidade : FK especialidadeId
PacienteConvenio "0..*" -- "1" Paciente : FK pacienteId
PacienteConvenio "0..*" -- "1" Convenio : FK convenioId
Agendamento "0..*" -- "1" Paciente : FK pacienteId
Agendamento "0..*" -- "1" Medico : FK medicoId
Agendamento "0..*" -- "1" Unidade : FK unidadeId
Agendamento "0..*" -- "1" Especialidade : FK especialidadeId
Agendamento "0..*" -- "0..1" PacienteConvenio : FK pacienteConvenioId
