@startuml
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
skinparam class {
 BackgroundColor #F0F7F3
 BorderColor #598574
}
hide empty methods
title Clínica Integrada — modelo relacional completo
entity Paciente {
  id: Int <<PK>>
  cpf: String <<UQ>> @db.VarChar(11)
  nome: String
  nascimento: DateTime @db.Date
  sexo: String
  telefone: String
  email: String
  endereco: String
  criadoEm: DateTime
}
entity Prontuario {
  id: Int <<PK>>
  pacienteId: Int <<UQ>>
  criadoEm: DateTime
}
entity Alergia {
  id: Int <<PK>>
  nome: String <<UQ>>
  descricao: String
}
entity PacienteAlergia {
  pacienteId: Int
  alergiaId: Int
  observacoes: String
}
entity Profissional {
  id: Int <<PK>>
  nome: String
  cpf: String <<UQ>> @db.VarChar(11)
  telefone: String
  email: String
  nascimento: DateTime @db.Date
  registro: String
}
entity Medico {
  profissionalId: Int <<PK>>
  crm: String
  ufCrm: String @db.VarChar(2)
}
entity Especialidade {
  id: Int <<PK>>
  nome: String <<UQ>>
  descricao: String
}
entity MedicoEspecialidade {
  medicoId: Int
  especialidadeId: Int
}
entity Unidade {
  id: Int <<PK>>
  nome: String
  endereco: String
  telefone: String
  horario: String
}
entity ProfissionalUnidade {
  profissionalId: Int
  unidadeId: Int
}
entity UnidadeEspecialidade {
  unidadeId: Int
  especialidadeId: Int
}
entity Convenio {
  id: Int <<PK>>
  nome: String
  cnpj: String <<UQ>> @db.VarChar(14)
  telefone: String
}
entity PacienteConvenio {
  id: Int <<PK>>
  pacienteId: Int
  convenioId: Int
  carteirinha: String
  adesao: DateTime @db.Date
  ativo: Boolean
}
entity Agendamento {
  id: Int <<PK>>
  pacienteId: Int
  medicoId: Int
  unidadeId: Int
  especialidadeId: Int
  pacienteConvenioId: Int?
  convenioHistorico: String?
  inicio: DateTime @db.Timestamptz(3)
  fim: DateTime @db.Timestamptz(3)
  situacao: SituacaoAgenda
  observacoes: String
}
entity Consulta {
  id: Int <<PK>>
  agendamentoId: Int <<UQ>>
  pacienteId: Int
  medicoId: Int
  unidadeId: Int
  especialidadeId: Int
  data: DateTime @db.Timestamptz(3)
  queixa: String
  observacoes: String
  diagnostico: String
  conduta: String
}
entity Exame {
  id: Int <<PK>>
  nome: String
  descricao: String
  tipo: String
}
entity SolicitacaoExame {
  id: Int <<PK>>
  pacienteId: Int
  consultaId: Int
  exameId: Int
  solicitadoEm: DateTime @db.Timestamptz(3)
  situacao: SituacaoExame
  realizadoEm: DateTime? @db.Timestamptz(3)
  resultado: String?
}
entity Medicamento {
  id: Int <<PK>>
  nome: String
  principioAtivo: String
  fabricante: String
  apresentacao: String
}
entity Prescricao {
  id: Int <<PK>>
  consultaId: Int
  data: DateTime
}
entity ItemPrescricao {
  id: Int <<PK>>
  prescricaoId: Int
  medicamentoId: Int
  quantidade: Int
  dose: String
  frequencia: String
  duracao: String
  observacoes: String
}
entity Procedimento {
  id: Int <<PK>>
  nome: String
  descricao: String
  valorPadrao: Decimal @db.Decimal(12, 2)
}
entity ProcedimentoRealizado {
  id: Int <<PK>>
  consultaId: Int
  procedimentoId: Int
  profissionalId: Int
  data: DateTime @db.Timestamptz(3)
  valorCobrado: Decimal @db.Decimal(12, 2)
}
entity Cobranca {
  id: Int <<PK>>
  consultaId: Int
  procedimentoRealizadoId: Int?
  pacienteConvenioId: Int?
  grupo: String
  origem: String
  valor: Decimal @db.Decimal(12, 2)
  responsavel: Responsavel
  vencimento: DateTime @db.Date
  emitidaEm: DateTime @db.Timestamptz(3)
  situacao: SituacaoCobranca
}
entity Pagamento {
  id: Int <<PK>>
  cobrancaId: Int
  data: DateTime @db.Timestamptz(3)
  valor: Decimal @db.Decimal(12, 2)
  forma: FormaPagamento
  situacao: SituacaoPagamento
  chave: String <<UQ>>
}
entity Usuario {
  id: Int <<PK>>
  nome: String
  email: String <<UQ>>
  senhaHash: String
  perfil: Perfil
  ativo: Boolean
  profissionalId: Int? <<UQ>>
}
entity Sessao {
  id: String <<PK>>
  usuarioId: Int
  expiraEm: DateTime
}
entity Auditoria {
  id: Int <<PK>>
  usuarioId: Int?
  acao: String
  recurso: String
  recursoId: String?
  data: DateTime
}
entity AnotacaoEnfermagem {
  id: Int <<PK>>
  prontuarioId: Int
  profissionalId: Int
  texto: String
  data: DateTime
}
Prontuario "1" -- "1" Paciente : FK pacienteId
PacienteAlergia "0..*" -- "1" Paciente : FK pacienteId
