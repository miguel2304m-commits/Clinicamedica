Consulta "0..*" -- "1" Paciente : FK pacienteId
Consulta "0..*" -- "1" Medico : FK medicoId
Consulta "0..*" -- "1" Unidade : FK unidadeId
Consulta "0..*" -- "1" Especialidade : FK especialidadeId
SolicitacaoExame "0..*" -- "1" Paciente : FK pacienteId
SolicitacaoExame "0..*" -- "1" Consulta : FK consultaId,pacienteId
SolicitacaoExame "0..*" -- "1" Exame : FK exameId
Prescricao "0..*" -- "1" Consulta : FK consultaId
ItemPrescricao "1..*" -- "1" Prescricao : FK prescricaoId
ItemPrescricao "0..*" -- "1" Medicamento : FK medicamentoId
ProcedimentoRealizado "0..*" -- "1" Consulta : FK consultaId
ProcedimentoRealizado "0..*" -- "1" Procedimento : FK procedimentoId
ProcedimentoRealizado "0..*" -- "1" Profissional : FK profissionalId
Cobranca "0..*" -- "1" Consulta : FK consultaId
Cobranca "0..*" -- "0..1" ProcedimentoRealizado : FK procedimentoRealizadoId
Cobranca "0..*" -- "0..1" PacienteConvenio : FK pacienteConvenioId
Pagamento "0..*" -- "1" Cobranca : FK cobrancaId
Usuario "0..1" -- "0..1" Profissional : FK profissionalId
Sessao "0..*" -- "1" Usuario : FK usuarioId
Auditoria "0..*" -- "0..1" Usuario : FK usuarioId
AnotacaoEnfermagem "0..*" -- "1" Prontuario : FK prontuarioId
AnotacaoEnfermagem "0..*" -- "1" Profissional : FK profissionalId
@enduml
