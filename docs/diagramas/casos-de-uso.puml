@startuml
!pragma layout smetana
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam backgroundColor #FFFFFF
actor Administrador as Admin
actor Recepcionista as Recep
actor Médico as Med
actor "Enfermagem / apoio clínico" as Enf
actor Financeiro as Fin
rectangle "Sistema de Gestão de Clínica Médica" {
  usecase "UC01 Autenticar e encerrar sessão" as UC01
  usecase "UC02 Manter pacientes" as UC02
  usecase "UC03 Manter unidades, especialidades\ne profissionais" as UC03
  usecase "UC04 Gerenciar convênios e vínculos" as UC04
  usecase "UC05 Agendar atendimento" as UC05
  usecase "UC06 Confirmar, cancelar\ne registrar ausência" as UC06
  usecase "UC07 Realizar consulta" as UC07
  usecase "UC08 Consultar prontuário e histórico" as UC08
  usecase "UC09 Solicitar exame" as UC09
  usecase "UC10 Acompanhar exame e registrar resultado" as UC10
  usecase "UC11 Prescrever medicamentos" as UC11
  usecase "UC12 Registrar procedimento" as UC12
  usecase "UC13 Registrar alergia / anotação" as UC13
  usecase "UC14 Emitir cobranças" as UC14
  usecase "UC15 Receber e estornar pagamento" as UC15
  usecase "UC16 Consultar indicadores e relatórios" as UC16
  usecase "UC17 Gerenciar contas e perfis" as UC17
  usecase "UC18 Consultar auditoria" as UC18
  usecase "UC19 Manter catálogos clínicos" as UC19
  usecase "UC20 Consultar agenda" as UC20
  usecase "UC21 Validar vínculos e sobreposição" as UC21
  usecase "UC22 Abrir prontuário único" as UC22
  usecase "UC23 Calcular saldo" as UC23
  usecase "UC24 Dividir cobertura entre pagadores" as UC24
  usecase "UC25 Reagendar atendimento" as UC25
  usecase "UC26 Cadastrar paciente" as UC26
}
Admin -- UC01
Recep -- UC01
Med -- UC01
Enf -- UC01
Fin -- UC01
Admin -- UC02
Recep -- UC02
Admin -- UC03
Admin -- UC04
Recep -- UC04
Admin -- UC05
Recep -- UC05
Admin -- UC06
Recep -- UC06
Med -- UC07
Med -- UC08
Enf -- UC08
Med -- UC09
Med -- UC10
Enf -- UC10
Med -- UC11
Med -- UC12
Med -- UC13
Enf -- UC13
Admin -- UC14
Fin -- UC14
Admin -- UC15
Fin -- UC15
Admin -- UC16
Fin -- UC16
Admin -- UC17
Admin -- UC18
Admin -- UC19
Admin -- UC20
Recep -- UC20
Med -- UC20
Enf -- UC20
UC05 ..> UC21 : <<include>>
Admin -- UC25
Recep -- UC25
Admin -- UC26
Recep -- UC26
UC25 ..> UC21 : <<include>>
UC26 ..> UC22 : <<include>>
UC15 ..> UC23 : <<include>>
UC24 ..> UC14 : <<extend>>\n[cobertura maior que zero]
note bottom of UC08
Médico: histórico dos pacientes sob atendimento.
Enfermagem: alergias e anotações das suas unidades.
Não inclui acesso a diagnóstico ou prescrição.
end note
note bottom of UC10
Enfermagem pode agendar; resultado
somente pelo médico da consulta.
end note
note bottom of UC16
Dashboard operacional disponível aos demais
perfis; relatórios financeiros apenas Admin/Fin.
end note
@enduml
